---
const { active = '' } = Astro.props;
const cls = (name: string) => `nav__link${active === name ? ' nav__link--active' : ''}`;
---
<nav class="nav" role="navigation" aria-label="Main navigation">
  <div class="nav__inner">
    <a href="/" class="nav__logo" aria-label="TACTUN Home">
      <img src="/assets/logo.png" alt="TACTUN" width="140" height="36">
    </a>
    <div class="nav__links">
      <a href="/platform/" class={cls('platform')}>Platform</a>
      <a href="/use-cases/" class={cls('use-cases')}>Use Cases</a>
      <a href="/blog/" class={cls('insights')}>Insights</a>
      <a href="/about/" class={cls('about')}>About</a>
      <a href="/contact/" class="nav__cta">Request a Quote &rarr;</a>
    </div>
    <button class="nav__hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav__mobile">
  <a href="/platform/" class={cls('platform')}>Platform</a>
  <a href="/use-cases/" class={cls('use-cases')}>Use Cases</a>
  <a href="/blog/" class={cls('insights')}>Insights</a>
  <a href="/about/" class={cls('about')}>About</a>
  <a href="/contact/" class="nav__cta">Request a Quote &rarr;</a>
</div>
