---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src="/assets/logo.png" alt="TACTUN" width="140" height="36">
        <p>Custom Control Systems for Intelligent Machines.</p>
      </div>
      <div class="footer__col">
        <h4>Platform</h4>
        <a href="/platform">Technology</a>
        <a href="/use-cases">Use Cases</a>
        <a href="/platform#how-we-work">How We Work</a>
      </div>
      <div class="footer__col">
        <h4>Company</h4>
        <a href="/about">About Us</a>
        <a href="/about#team">Team</a>
        <a href="/about#careers">Careers</a>
      </div>
      <div class="footer__col">
        <h4>Connect</h4>
        <a href="mailto:contact@tactun.com">contact@tactun.com</a>
        <a href="https://www.linkedin.com/company/tactun" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://www.youtube.com/@tactunplatform" target="_blank" rel="noopener">YouTube</a>
      </div>
    </div>
    <div class="footer__tactun-link">
      For materials testing solutions, visit <a href="https://tactun.com" target="_blank" rel="noopener">tactun.com</a>
    </div>
    <div class="footer__bottom">
