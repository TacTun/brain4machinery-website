---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);
---
<BaseLayout
  title="Blog — TACTUN brain4machinery"
  description="Field notes on AI-native control, FPGA + Jetson architecture, and building hardware for robots and intelligent machines."
  active="insights"
>
  <section class="hero hero--short section">
    <div class="container">
      <div class="section-header section-header--center" style="margin-bottom: 0;">
        <span class="label">Blog</span>
        <h1>Field notes on <span class="accent">control electronics</span> for intelligent machines.</h1>
        <p>What we're learning while designing AI-native controllers for robotics, autonomous machines, and specialty equipment.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 2rem;">
    <div class="container">
      {posts.length === 0 ? (
        <p class="text-muted text-center" style="font-size: 1.0625rem;">
          New posts coming soon. In the meantime, see the <a href="/platform">platform</a> or <a href="/contact">tell us about your project</a>.
        </p>
      ) : (
        <div class="grid grid--2">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="card" style="text-decoration: none; display: block;">
              <h3 class="card__title" style="font-size: 1.25rem;">{post.data.title}</h3>
              <p class="card__text" style="margin-top: 0.5rem;">{post.data.description}</p>
              <p class="text-muted" style="font-size: 0.8125rem; margin-top: 0.75rem;">
                {post.data.publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
